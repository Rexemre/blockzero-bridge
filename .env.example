# BSC deployer (pays gas once)
BSC_DEPLOYER_PRIVATE_KEY=0x...

# Relayer operator — receives MINTER_ROLE on wBLOZ (can mint; keep funded with BNB)
BSC_OPERATOR_ADDRESS=0x...
BSC_OPERATOR_PRIVATE_KEY=0x...

BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_CHAIN_ID=56

# Free at https://bscscan.com/myapikey — required for npm run verify:bsc
BSCSCAN_API_KEY=

# After deploy (deployments.json)
WBLOZ_ADDRESS=0x...
BRIDGE_ADDRESS=0x...
# After deploy:claim (scripts/deploy-claim.ts)
WRAP_CLAIM_ADDRESS=0x...

# Block Zero node (same machine as seed recommended)
BLOZ_CLI=/opt/blockzero-core/build/bin/bitcoin-cli
BLOZ_DATADIR=/opt/bzero-mainnet
BLOZ_BRIDGE_WALLET=bridge
BLOZ_CONFIRMATIONS=6
MIN_WRAP_BLOZ=0.01
UNWRAP_NETWORK_FEE_BLOZ=0.00001
# Bridge service fee in basis points (390 = 3.9%), applied on wrap mint and unwrap payout
BRIDGE_FEE_BPS=390
# Dedicated bz1 address that receives the 3.9% bridge fee (wrap after mint + unwrap payout)
BRIDGE_FEE_BZ1_ADDRESS=bz1qcunyqhyv0veuf86u0xhkpf7kslpuuy3zvdfymn
UNWRAP_MAX_ATTEMPTS=5
UNWRAP_RETRY_DELAY_MS=60000
WRAP_EXPIRY_HOURS=48
CLAIM_EXPIRY_HOURS=168
REFUND_MAX_ATTEMPTS=5
REFUND_RETRY_DELAY_MS=60000
CLAIM_SIG_TTL_SEC=3600

# Transparency (optional — defaults shown on bridge.bloz.org)
BSC_DEPLOYER_ADDRESS=0x...
# BSC_OPERATOR_ADDRESS already set above
BRIDGE_GITHUB_URL=https://github.com/Rexemre/blockzero-bridge
BRIDGE_DOCS_URL=https://github.com/Rexemre/blockzero-docs/blob/main/bridge-guide.md

# Relayer service
BRIDGE_PORT=3010
BRIDGE_DB_PATH=/opt/blockzero-bridge/data/bridge.db
BRIDGE_WEB_DIR=/opt/blockzero-bridge/web

BSC_POLL_MS=12000
BLOZ_POLL_MS=15000
